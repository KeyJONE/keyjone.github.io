<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><munder><mrow><mi mathvariant="normal">Assemble</mi><mo>⁡</mo></mrow><mi>k</mi></munder><mrow><mo fence="true">[</mo><msub><mi>V</mi><mi>k</mi></msub><msubsup><mover accent="true"><mi mathvariant="bold">B</mi><mo stretchy="true">‾</mo></mover><mi>k</mi><mrow><mi>V</mi><mo separator="true">,</mo><mi mathvariant="normal">c</mi></mrow></msubsup><mo fence="true">]</mo></mrow><mo>=</mo><munder><mrow><mi mathvariant="normal">Assemble</mi><mo>⁡</mo></mrow><mi>e</mi></munder><mrow><mo fence="true">[</mo><msub><mi>V</mi><mi>e</mi></msub><msub><mi mathvariant="bold">B</mi><mi>e</mi></msub><mo fence="true">]</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">\operatorname*{Assemble}_k\left[V_k\overline{\mathbf{B}}_k^{V,\mathrm c}\right]
