/mi></msubsup><msup><mo stretchy="false">)</mo><mi>T</mi></msup><msubsup><mi mathvariant="bold">I</mi><mrow><mi>N</mi><mo separator="true">,</mo><mi>e</mi></mrow><mi>V</mi></msubsup></mrow><msub><mi>V</mi><mi>e</mi></msub></mfrac><mo fence="true">]</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><msub><mi mathvariant="bold-italic">S</mi><mrow><mi mathvariant="normal">P</mi><mi mathvariant="normal">P</mi><mi mathvariant="normal">P</mi></mrow></msub><mo>=</mo><munder><mrow><mi mathvariant="normal">Assemble</mi><mo>⁡</mo></mrow><mi>e</mi></munder><mo stretchy="false">[</mo><msubsup><mi mathvariant="bold-italic">S</mi><mrow><mi mathvariant="normal">P</mi><mi mathvariant="normal">P</mi><mi mathvariant="normal">P</mi></mrow><mi>e</mi></msubsup><mo stretchy="false">]</mo><mi mathvariant="normal">.</mi></mrow></mstyle></mtd></mtr></mtable></mstyle></mstyle></mstyle></menclose></mrow><annotation encoding="application/x-tex">\boxed{
\begin{aligned}
\bm{S}_{\mathrm{PPP}}^e
&amp;=c_{\mathrm{PPP}}\int_e(\mathbf{N}_e-\Pi_e^V\mathbf{N}_e)^T(\mathbf{N}_e-\Pi_e^V\mathbf{N}_e)\,\mathrm dV\\
&amp;=c_{\mathrm{PPP}}\left[\bm{M}_e^V-\frac{(\mathbf{I}_{N,e}^V)^T\mathbf{I}_{N,e}^V}{V_e}\right],
\qquad
\bm{S}_{\mathrm{PPP}}=\operatorname*{Assemble}_e[\bm{S}_{\mathrm{PPP}}^e].
\end{aligned}
}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:6.552em;vertical-align:-3.026em;"></span><span class="mord"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:3.526em;"><span style="top:-8.552em;"><span class="pstrut" style="height:8.552em;"></span><span class="boxpad"><span class="mord"><span class="mord"><span class="mord"><span class="mtable"><span class="col-align-r"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:3.186em;"><span style="top:-5.576em;"><span class="pstrut" style="height:3.75em;"></span><span class="mord"><span class="mord"><span class="mord"><span class="mord"><span class="mord boldsymbol" style="margin-right:0.05382em;">S</span></span></span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.7404em;"><span style="top:-2.453em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight"><span class="mord mathrm mtight">PPP</span></span></span></span></span><span style="top:-3.139em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">e</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.247em;"><span></span></span></span></span></span></span></span></span><span style="top:-2.614em;"><span class="pstrut" style="height:3.75em;"></span><span class="mord"></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:2.686em;"><span></span></span></span></span></span><span class="col-align-l"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:3.186em;"><span style="top: