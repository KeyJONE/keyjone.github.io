<p>因此，新增的两个局部矩阵为</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><menclose notation="box"><mstyle scriptlevel="0" displaystyle="false"><mstyle scriptlevel="0" displaystyle="false"><mstyle scriptlevel="0" displaystyle="true"><mrow><msubsup><mi>K</mi><mrow><mn>33</mn><mrow><mi mathvariant="normal">A</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">v</mi></mrow></mrow><mi>k</mi></msubsup><mo>=</mo><mfrac><mrow><mi mathvariant="normal">∂</mi><msubsup><mi mathvariant="bold-italic">f</mi><mrow><mi>T</mi><mo separator="true">,</mo><mi>k</mi></mrow><mrow><mi mathvariant="normal">a</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">v</mi></mrow></msubsup></mrow><mrow><mi mathvariant="normal">∂</mi><msub><mi mathvariant="bold-italic">T</mi><mi>k</mi></msub></mrow></mfrac><mo>=</mo><msub><mi>ρ</mi><mi>f</mi></msub><msub><mi>c</mi><mi>f</mi></msub><munderover><mo>∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mn>4</mn></munderover><msub><mi>W</mi><mrow><mi>k</mi><mi>g</mi></mrow></msub><msubsup><mover accent="true"><mi>N</mi><mo stretchy="true">~</mo></mover><mrow><mi>k</mi><mi>g</mi></mrow><mi>T</mi></msubsup><msubsup><mi mathvariant="bold-italic">q</mi><mrow><mi>f</mi><mo separator="true">,</mo><mi>k</mi><mi>g</mi></mrow><mi>T</mi></msubsup><msub><mover accent="true"><mi>E</mi><mo stretchy="true">~</mo></mover><mrow><mi>k</mi><mi>g</mi></mrow></msub><mo separator="true">,</mo></mrow></mstyle></mstyle></mstyle></menclose></mrow><annotation encoding="application/x-tex">\boxed{
